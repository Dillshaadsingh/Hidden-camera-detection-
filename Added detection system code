# IoT Hidden Camera Detection System
# Simple Demo Version

from scapy.all import sniff
from cryptography.fernet import Fernet
import numpy as np
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import SimpleRNN, Dense

print("Starting Hidden Camera Detection System...")

# -----------------------------
# AES Encryption Setup
# -----------------------------
key = Fernet.generate_key()
cipher = Fernet(key)

def encrypt_alert(message):
    encrypted = cipher.encrypt(message.encode())
    return encrypted

# -----------------------------
# RNN Model Setup
# -----------------------------
model = Sequential()
model.add(SimpleRNN(16, input_shape=(10,1)))
model.add(Dense(1, activation='sigmoid'))

model.compile(optimizer='adam',
              loss='binary_crossentropy',
              metrics=['accuracy'])

# Dummy training data
X = np.random.rand(50,10,1)
y = np.random.randint(0,2,50)

model.fit(X, y, epochs=3)

print("RNN Model Ready")

# -----------------------------
# Network Traffic Detection
# -----------------------------
suspicious_devices = []

def packet_callback(packet):
    if packet.haslayer("IP"):
        src = packet["IP"].src
        dst = packet["IP"].dst
        
        print(f"Traffic Detected: {src} -> {dst}")

        if src not in suspicious_devices:
            suspicious_devices.append(src)
            alert = encrypt_alert(f"Hidden Camera Suspected: {src}")
            print("Encrypted Alert:", alert)

def start_scan():
    print("Scanning Network Traffic...")
    sniff(prn=packet_callback, count=10)

# -----------------------------
# Start System
# -----------------------------
start_scan()

print("Scan Completed")
